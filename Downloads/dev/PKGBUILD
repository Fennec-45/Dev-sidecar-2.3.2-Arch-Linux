  'graphite'
  'gtk3'
  'harfbuzz'
  'icu'
  'json-glib'
  'leancrypto'
  'libcloudproviders'
  'libdatrie'
  'libdrm'
  'libepoxy'
  'libffi'
  'libidn2'
  'libpng'
  'libseccomp'
