makedepends=('gendesk')
checkdepends=()
optdepends=()
provides=("${_upstream}")
conflicts=("${_upstream}")
replaces=()
backup=()
options=('!strip')
install=
changelog=
source=("${_upstream}-$pkgver-linux-x86_64.tar.gz::https://github.com/docmirror/dev-sidecar/releases/download/v2.3.2/DevSidecar-2.3.2-linux-x86_64.tar.gz")
noextract=()
sha256sums=('46e33498b0dac8da852b9c2cee785bdbeae1ba89ef8f7a26ec5c53e5238c2a10')
validpgpkeys=()
package() {
    cd "$srcdir/$_upstream-$pkgver-x64"


    install -d "$pkgdir/opt/dev-sidecar"
    cp -a . "$pkgdir/opt/dev-sidecar/"

    install -d "$pkgdir/usr/bin"
    ln -s /opt/dev-sidecar/dev-sidecar-gui "$pkgdir/usr/bin/dev-sidecar-gui"


    gendesk -n --pkgname="$pkgname" \
        --name="DevSidecar" \
        --exec="dev-sidecar-gui" \
        --comment="开发者边车"\
        --categories="Network" \
        --icon="dev-sidecar"\
        --output="$pkgname.desktop"
    install -Dm644 "$pkgname.desktop" \
        "$pkgdir/usr/share/applications/dev-sidecar.desktop"

    install -Dm644 "resources/extra/icons/tray-icon.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/dev-sidecar.png"


    install -Dm644 "LICENSE.electron.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
